CI_ENVIRONMENT=production
# Change to development to displays ci4 errors

database.default.hostname=localhost
database.default.database=griffith
database.default.username=griffith
database.default.password=<too-many-secrets>
database.default.DBDriver=MySQLi
database.default.DBPrefix=
database.default.port=3306

# !!!!!!!
# All settings below are stored in the database but can be overridden via this file
# !!!!!!!

# Base URL for redirects
#app.baseURL='http://site.fqdn.com/'

# Application Name
# This name will be displayed in page titles, headers, and throughout the application
#app.name='Media Organizer'

# Authentication
# Initial admin password - used only if no password file exists
# Change this immediately after first login
auth.initialPassword=admin123

# Get your API key from https://www.themoviedb.org/settings/api
# Leave commented if you do not have a key
# TMDB_API_KEY=your_api_key_here

# IGDB API Key (for Video Games) - Get from https://api-docs.igdb.com/
# IGDB_CLIENT_ID=your_client_id_here
# IGDB_CLIENT_SECRET=your_client_secret_here

# MusicBrainz API (No key required for basic usage, but a User-Agent is mandatory)
# Set your email for MusicBrainz API compliance
# MUSICBRAINZ_EMAIL=your-email@example.com

# Enabled Media Lookups (comma-separated list)
# Supported: IMDB, TMDB, TVDB, IGDB, MusicBrainz
# Default: IMDB, TVDB
#ENABLED_LOOKUPS=IMDB,TVDB

# Email settings
#email.protocol=smtp
#email.SMTPHost=smtp.gmail.com
#email.SMTPUser='your-email@gmail.com'
#email.SMTPPass='your-app-password'
#email.SMTPPort=587
#email.SMTPCrypto=tls
#email.fromEmail='your-email@gmail.com'
# Note: It's recommended to keep email.fromName the same as app.name for consistency
#email.fromName='Media Organizer'

# SSL Certificate Verification (set to false to ignore certificate errors)
# WARNING: Disabling SSL verification is not recommended for production environments
# Only disable if you're using self-signed certificates or have certificate CN mismatch issues
#email.SMTPVerifyPeer=false
#email.SMTPVerifyPeerName=false